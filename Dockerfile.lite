# ==============================================================================
# ConvertX-CN Lite 版 Docker Image
# 版本：v0.1.24-lite
# ==============================================================================
#
# 📦 Image 說明：
#   - ConvertX-CN 精簡版，只保留最常用的轉換功能
#   - 體積優化版（目標 < 1.5 GB）
#   - 移除 AI/OCR/翻譯/電子書/LaTeX 等進階功能
#
# ✅ Lite 版包含的轉換引擎（精選最常用）：
#   - LibreOffice（文件轉檔：DOC/DOCX/XLS/PPT → PDF）
#   - FFmpeg（影音轉檔：MP4/MP3/AVI/MKV）
#   - GraphicsMagick（圖片轉檔：PNG/JPG/GIF/WEBP）
#   - Pandoc（文件格式：Markdown/HTML/DOCX）
#   - Ghostscript + qpdf（PDF 處理：PDF/A、合併、分割）
#   - Potrace + VTracer（點陣圖轉向量）
#   - libheif（HEIF/HEIC 圖片）
#   - libjxl（JPEG XL 圖片）
#   - resvg（SVG 渲染）
#   - dasel（JSON/YAML/TOML 資料轉換）
#   - msgconvert（Outlook MSG 轉換）
#   - Markitdown（文件轉 Markdown）
#
# ❌ Lite 版不包含（減少體積）：
#   - Calibre（電子書，約 +500MB）
#   - TexLive/XeLaTeX（LaTeX，約 +1GB）
#   - Inkscape（向量圖，約 +300MB）
#   - ImageMagick（用 GraphicsMagick 替代）
#   - Assimp（3D 資產）
#   - libvips（用 GraphicsMagick 替代）
#   - OCR/Tesseract
#   - AI 模型 / VLM / YOLO
#   - PDFMathTranslate / BabelDOC / MinerU
#
# 📊 Image 大小：目標 < 1.5 GB
#
# ==============================================================================

FROM debian:bookworm-slim AS base
LABEL org.opencontainers.image.source="https://github.com/pi-docket/ConvertX-CN"
LABEL org.opencontainers.image.description="ConvertX-CN Lite - 精簡版檔案轉換服務"
LABEL org.opencontainers.image.version="v0.1.24-lite"
WORKDIR /app

# 配置 APT 重試機制
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries \
    && echo 'Acquire::http::Timeout "120";' >> /etc/apt/apt.conf.d/80-retries \
    && echo 'Acquire::https::Timeout "120";' >> /etc/apt/apt.conf.d/80-retries \
    && echo 'DPkg::Lock::Timeout "120";' >> /etc/apt/apt.conf.d/80-retries

# 安裝 Bun
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
    curl -fsSL -o bun-linux-aarch64.zip https://github.com/oven-sh/bun/releases/download/bun-v1.3.6/bun-linux-aarch64.zip; \
    else \
    curl -fsSL -o bun-linux-x64-baseline.zip https://github.com/oven-sh/bun/releases/download/bun-v1.3.6/bun-linux-x64-baseline.zip; \
    fi

RUN unzip -j bun-linux-*.zip -d /usr/local/bin && \
    rm bun-linux-*.zip && \
    chmod +x /usr/local/bin/bun

# ==============================================================================
# 安裝依賴
# ==============================================================================
FROM base AS install
RUN mkdir -p /temp/dev
COPY package.json bun.lock /temp/dev/
RUN cd /temp/dev && bun install --frozen-lockfile

RUN mkdir -p /temp/prod
COPY package.json bun.lock /temp/prod/
RUN cd /temp/prod && bun install --frozen-lockfile --production

# ==============================================================================
# 建構應用程式
# ==============================================================================
FROM base AS prerelease
WORKDIR /app
COPY --from=install /temp/dev/node_modules node_modules
COPY . .
RUN bun run build

# ==============================================================================
# Release Stage - Lite 版本
# ==============================================================================
FROM base AS release

# 配置 APT
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries \
    && echo 'APT::Get::Assume-Yes "true";' >> /etc/apt/apt.conf.d/80-retries \
    && echo 'DPkg::Lock::Timeout "120";' >> /etc/apt/apt.conf.d/80-retries

# ------------------------------------------------------------------------------
# 階段 1：基礎系統工具
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    locales \
    ca-certificates \
    curl \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 2：PDF 處理工具（Ghostscript + qpdf + poppler）
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    ghostscript \
    qpdf \
    poppler-utils \
    mupdf-tools \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 3：圖片處理工具
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    graphicsmagick \
    libheif-examples \
    libjxl-tools \
    potrace \
    dcraw \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 4：影音處理工具（FFmpeg）
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 5：文件處理工具（Pandoc + msgconvert）
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    pandoc \
    libemail-outlook-message-perl \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 6：LibreOffice（核心文件轉檔引擎）
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    libreoffice \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 7：字型安裝
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    fonts-noto-cjk \
    fonts-liberation \
    fonts-dejavu-core \
    fontconfig \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 8：Python + Markitdown
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    pipx \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.local/bin:${PATH}"
RUN pipx install "markitdown[all]"

# ------------------------------------------------------------------------------
# 階段 9：Headless 支援
# ------------------------------------------------------------------------------
RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    xauth \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 階段 10：安裝 dasel（從 GitHub 下載）
# ------------------------------------------------------------------------------
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
    DASEL_ARCH="linux_arm64"; \
    else \
    DASEL_ARCH="linux_amd64"; \
    fi && \
    curl -sSLf "https://github.com/TomWright/dasel/releases/download/v2.8.1/dasel_${DASEL_ARCH}" -o /usr/local/bin/dasel && \
    chmod +x /usr/local/bin/dasel

# ------------------------------------------------------------------------------
# 階段 11：安裝 resvg（從 GitHub 下載）
# ------------------------------------------------------------------------------
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
    echo "resvg 沒有 ARM64 預編譯版本，跳過安裝"; \
    else \
    curl -sSLf "https://github.com/linebender/resvg/releases/download/v0.44.0/resvg-linux-x86_64.tar.gz" -o /tmp/resvg.tar.gz && \
    tar -xzf /tmp/resvg.tar.gz -C /tmp/ && \
    mv /tmp/resvg /usr/local/bin/resvg && \
    chmod +x /usr/local/bin/resvg && \
    rm -f /tmp/resvg.tar.gz; \
    fi

# ------------------------------------------------------------------------------
# 階段 12：安裝 VTracer（從 GitHub 下載）
# ------------------------------------------------------------------------------
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
    VTRACER_ASSET="vtracer-aarch64-unknown-linux-musl.tar.gz"; \
    else \
    VTRACER_ASSET="vtracer-x86_64-unknown-linux-musl.tar.gz"; \
    fi && \
    curl -L -o /tmp/vtracer.tar.gz "https://github.com/visioncortex/vtracer/releases/download/0.6.4/${VTRACER_ASSET}" && \
    tar -xzf /tmp/vtracer.tar.gz -C /tmp/ && \
    mv /tmp/vtracer /usr/local/bin/vtracer && \
    chmod +x /usr/local/bin/vtracer && \
    rm -f /tmp/vtracer.tar.gz

# ------------------------------------------------------------------------------
# 階段 13：建立 VCF to CSV 轉換器
# ------------------------------------------------------------------------------
RUN printf '%s\n' \
    '#!/usr/bin/env python3' \
    'import sys, csv' \
    'def parse_vcf(content):' \
    '    contacts, contact = [], {}' \
    '    for line in content.split("\\n"):' \
    '        line = line.strip()' \
    '        if line.startswith("BEGIN:VCARD"): contact = {}' \
    '        elif line.startswith("END:VCARD") and contact: contacts.append(contact)' \
    '        elif ":" in line:' \
    '            key, val = line.split(":", 1)' \
    '            key = key.split(";")[0].upper()' \
    '            if key in ["FN", "N", "TEL", "EMAIL", "ORG", "TITLE", "ADR"]: contact[key] = val' \
    '    return contacts' \
    'if len(sys.argv) != 3: sys.exit("Usage: vcf2csv input.vcf output.csv")' \
    'with open(sys.argv[1], "r", encoding="utf-8") as f: contacts = parse_vcf(f.read())' \
    'if contacts:' \
    '    keys = list(set(k for c in contacts for k in c.keys()))' \
    '    with open(sys.argv[2], "w", newline="", encoding="utf-8") as f:' \
    '        w = csv.DictWriter(f, fieldnames=keys); w.writeheader(); w.writerows(contacts)' \
    > /usr/local/bin/vcf2csv && chmod +x /usr/local/bin/vcf2csv

# ------------------------------------------------------------------------------
# 階段 14：Locale 設定
# ------------------------------------------------------------------------------
RUN sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && sed -i 's/# zh_TW.UTF-8 UTF-8/zh_TW.UTF-8 UTF-8/' /etc/locale.gen \
    && sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen

# ------------------------------------------------------------------------------
# 階段 15：安裝自訂字型
# ------------------------------------------------------------------------------
RUN mkdir -p /usr/share/fonts/truetype/custom
COPY fonts/ /usr/share/fonts/truetype/custom/
RUN fc-cache -fv

# ------------------------------------------------------------------------------
# 階段 16：清理
# ------------------------------------------------------------------------------
RUN rm -rf /usr/share/doc/* \
    && rm -rf /usr/share/man/* \
    && rm -rf /usr/share/info/* \
    && rm -rf /var/cache/apt/* \
    && rm -rf /tmp/*

# ==============================================================================
# 複製應用程式
# ==============================================================================
COPY --from=install /temp/prod/node_modules node_modules
COPY --from=prerelease /app/public/ /app/public/
COPY --from=prerelease /app/dist /app/dist

RUN mkdir -p data

EXPOSE 3000/tcp

# ==============================================================================
# 環境變數
# ==============================================================================
ENV LANG=zh_TW.UTF-8
ENV LC_ALL=zh_TW.UTF-8
ENV QT_QPA_PLATFORM="offscreen"
ENV DISPLAY=":99"
ENV NODE_ENV=production
ENV CONVERTX_EDITION="lite"

# ==============================================================================
# 啟動
# ==============================================================================
ENTRYPOINT [ "bun", "run", "dist/src/index.js" ]
