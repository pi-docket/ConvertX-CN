# ================================================
# ConvertX-CN 環境變數設定範例
# ================================================
# 
# 此檔案包含所有可用的環境變數設定。
# 複製此檔案為 .env 並根據需要修改。
#
# 注意：ConvertX-CN 不提供 UI 設定頁面
# 所有設定皆由環境變數控制
# ================================================

# ========== 必要設定 ==========

# JWT 密鑰（必須設定！建議 32+ 字元）
# 若不設定，每次重啟後所有使用者需重新登入
# 產生方式：openssl rand -base64 32
JWT_SECRET=請更換成至少32字元的隨機字串

# ========== 一般設定 ==========

# 系統時區（預設 UTC）
TZ=Asia/Taipei

# 介面語言（預設 auto 自動偵測）
# 可選：zh-TW, zh-CN, en, ja, ko 等 65 種
# LANGUAGE=zh-TW

# Web UI 監聯端口
PORT=3000

# 子路徑前綴（用於反向代理配置）
# WEBROOT=/convertx

# 資料目錄
DATA_DIR=./data

# ========== 安全設定 ==========

# 是否允許 HTTP 連線（預設 false）
# 本地測試時設為 true
# HTTP_ALLOWED=true

# 是否信任反向代理（預設 false）
# 使用 Nginx/Traefik/Caddy 時設為 true
# TRUST_PROXY=true

# 是否允許註冊新帳號（預設 true）
# ACCOUNT_REGISTRATION=false

# 是否允許匿名使用（預設 false）
# ALLOW_UNAUTHENTICATED=true

# ========== MinerU 處理模式 ==========

# 處理模式：pipeline（預設）或 vlm
# - pipeline: 穩定的 OCR 處理模式，無需額外依賴
# - vlm: 視覺語言模型模式，需要 llama-server
#
# 重要：若 VLM 不可用，系統會自動回退到 pipeline
MINERU_MODE=pipeline

# VLM server 地址（使用 VLM 模式時）
# MINERU_VLM_URL=http://127.0.0.1:11785/v1

# llama.cpp server 參數（進階設定）
# LLAMA_CTX_SIZE=16384
# LLAMA_BATCH_SIZE=2048
# LLAMA_IMAGE_MAX_TOKENS=4096

# ========== 翻譯服務設定（BabelDOC）==========

# 翻譯引擎：local（預設）、openai、deepseek、custom
# - local: 使用本地 llama-server，無需 API Key
# - openai: 使用 OpenAI API
# - deepseek: 使用 DeepSeek API
# - custom: 使用自訂 API 端點
BABELDOC_ENGINE=local

# API Keys（使用 openai/deepseek/custom 時需設定）
# OPENAI_API_KEY=sk-proj-...
# DEEPSEEK_API_KEY=sk-...
# OTHER_LLM_API_KEY=...
# CUSTOM_LLM_BASE_URL=https://api.example.com/v1

# ========== 轉換設定 ==========

# 自動刪除轉換檔案的間隔（小時，預設 24）
# AUTO_DELETE_EVERY_N_HOURS=12

# 最大同時轉換任務數（預設 0 表示無限制）
# MAX_CONVERT_PROCESS=4

# 是否隱藏轉換歷史（預設 false）
# HIDE_HISTORY=true

# 允許的檔案大小上限 (bytes，預設 500MB)
# HTTP_ALLOWED_FILE_SIZE=524288000

# ========== FFmpeg 設定（進階）==========

# FFmpeg 輸入參數
# FFMPEG_ARGS=-hwaccel cuda

# FFmpeg 輸出參數
# FFMPEG_OUTPUT_ARGS=-c:v h264_nvenc

# ========== PDF 翻譯設定 ==========

# PDFMathTranslate 翻譯服務（預設 google）
# PDFMATHTRANSLATE_SERVICE=google

# 模型路徑
# PDFMATHTRANSLATE_MODELS_PATH=/models

# ========== API Server 設定（選用）==========

# API Server 監聽端口
# RAS_API_PORT=7890

# ConvertX Web UI 後端地址（Docker 內部網路）
# CONVERTX_BACKEND_URL=http://convertx:3000
