{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["tests/**/*.test.ts", "src/i18n/index.ts"],
  "project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
  "tailwind": {
    "entry": ["src/main.css"]
  },
  "ignore": [
    "src/i18n/**",
    "tests/e2e/helpers.ts",
    "src/inference/**",
    "src/helpers/translation/**",
    "src/helpers/llamaServerCheck.ts",
    "src/helpers/vlmServer.ts",
    "src/helpers/processingMode.ts",
    "src/helpers/apiKeys.ts",
    "src/helpers/env.ts",
    "src/db/types.ts"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true
}
