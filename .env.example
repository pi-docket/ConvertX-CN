# ================================================
# ConvertX-CN 環境變數設定範例
# ================================================
# 
# 此檔案包含所有可用的環境變數設定。
# 複製此檔案為 .env 並根據需要修改。
#
# 注意：ConvertX-CN 不提供 UI 設定頁面
# 所有設定皆由環境變數控制
# ================================================

# ========== 必要設定 ==========

# JWT 密鑰（必須設定！建議 32+ 字元）
# 若不設定，每次重啟後所有使用者需重新登入
# 產生方式：openssl rand -base64 32
JWT_SECRET=請更換成至少32字元的隨機字串

# ========== 一般設定 ==========

# 系統時區（預設 UTC）
TZ=Asia/Taipei

# 介面語言（預設 auto 自動偵測）
# 可選：zh-TW, zh-CN, en, ja, ko 等 65 種
# LANGUAGE=zh-TW

# Web UI 監聯端口
PORT=3000

# 子路徑前綴（用於反向代理配置）
# WEBROOT=/convertx

# 資料目錄
DATA_DIR=./data

# ========== 安全設定 ==========

# 是否允許 HTTP 連線（預設 false）
# 本地測試時設為 true
# HTTP_ALLOWED=true

# 是否信任反向代理（預設 false）
# 使用 Nginx/Traefik/Caddy 時設為 true
# TRUST_PROXY=true

# 是否允許註冊新帳號（預設 true）
# ACCOUNT_REGISTRATION=false

# 是否允許匿名使用（預設 false）
# ALLOW_UNAUTHENTICATED=true

# ========== MinerU 處理模式 ==========

# 處理模式（預設 pipeline）
# 可選：pipeline（穩定）, vlm（實驗性）
# 注意：本地 VLM / llama.cpp 功能已移除
# MINERU_MODE=pipeline

# ========== 翻譯服務設定（BabelDOC）==========

# BabelDOC 翻譯引擎（預設 siliconflow）
# 可選：siliconflow, openai, deepseek, custom, placeholder
# BABELDOC_ENGINE=siliconflow

# ========== 自定義部署（可選）==========

# 自定義 SiliconFlow Worker 部署（進階用戶）
# 預設使用內置的 Worker 服務，無需配置
# 如需使用自己的 Worker 服務，取消註解並設定以下項目：
# CONVERTX_WORKER_URL=https://your-worker-url.workers.dev
# CONVERTX_ENCRYPTION_KEY=your-encryption-passphrase

# ========== OpenAI 翻譯服務（可選）==========

# 使用 OpenAI API 進行翻譯時設定（如已配置 BABELDOC_ENGINE=openai）
# OPENAI_API_KEY=sk-proj-...

# ========== DeepSeek 翻譯服務（可選）==========

# 使用 DeepSeek API 進行翻譯時設定（如已配置 BABELDOC_ENGINE=deepseek）
# DEEPSEEK_API_KEY=sk-...

# ========== 自定義翻譯服務（可選）==========

# 使用自定義 API 進行翻譯時設定（如已配置 BABELDOC_ENGINE=custom）
# CUSTOM_LLM_BASE_URL=https://api.example.com/v1
# OTHER_LLM_API_KEY=your-api-key

# ========== 轉換設定 ==========

# 自動刪除轉換檔案的間隔（小時，預設 24）
# AUTO_DELETE_EVERY_N_HOURS=12

# 最大同時轉換任務數（預設 0 表示無限制）
# MAX_CONVERT_PROCESS=4

# 是否隱藏轉換歷史（預設 false）
# HIDE_HISTORY=true

# 允許的檔案大小上限 (bytes，預設 500MB)
# HTTP_ALLOWED_FILE_SIZE=524288000

# ========== FFmpeg 設定（進階）==========

# FFmpeg 輸入參數
# FFMPEG_ARGS=-hwaccel cuda

# FFmpeg 輸出參數
# FFMPEG_OUTPUT_ARGS=-c:v h264_nvenc

# ========== PDF 翻譯設定 ==========

# PDFMathTranslate 翻譯服務（預設 google）
# PDFMATHTRANSLATE_SERVICE=google

# 模型路徑
# PDFMATHTRANSLATE_MODELS_PATH=/models

# ========== API Server 設定（選用）==========

# API Server 監聽端口
# RAS_API_PORT=7890

# ConvertX Web UI 後端地址（Docker 內部網路）
# CONVERTX_BACKEND_URL=http://convertx:3000
