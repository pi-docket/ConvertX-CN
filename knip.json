{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["tests/**/*.test.ts", "tests/security/helpers/*.ts", "src/i18n/index.ts"],
  "project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
  "ignoreBinaries": [
    "pandoc",
    "ffmpeg",
    "vips",
    "magick",
    "gm",
    "inkscape",
    "djxl",
    "dasel",
    "xelatex",
    "resvg",
    "assimp",
    "ebook-convert",
    "heif-info",
    "potrace",
    "soffice",
    "perl",
    "markitdown"
  ],
  "tailwind": {
    "entry": ["src/main.css"]
  },
  "ignore": [
    "src/i18n/**",
    "tests/e2e/helpers.ts",
    "src/inference/**",
    "src/helpers/translation/**",
    "src/helpers/llamaServerCheck.ts",
    "src/helpers/vlmServer.ts",
    "src/helpers/processingMode.ts",
    "src/helpers/apiKeys.ts",
    "src/helpers/env.ts",
    "src/db/types.ts",
    "src/ai/**"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true
}
