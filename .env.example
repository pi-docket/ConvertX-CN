# ================================================
# ConvertX-CN 環境變數設定範例
# ================================================
# 
# 此檔案包含所有可用的環境變數設定。
# 複製此檔案為 .env 並根據需要修改。
#
# 注意：ConvertX-CN 不提供 UI 設定頁面
# 所有設定皆由環境變數控制
# ================================================

# ========== 安全設定 ==========

# JWT 密鑰（選用；自行設定時至少 32 字元）
# 若不設定，會在 DATA_DIR/.secrets/jwt-secret 原子產生並跨重啟沿用。
# 請備份該檔案；也可用 JWT_SECRET_FILE 指向外部 secret。
# 產生方式：openssl rand -base64 32
# JWT_SECRET=replace-with-at-least-32-random-characters
# JWT_SECRET_FILE=./data/.secrets/jwt-secret

# ========== 一般設定 ==========

# 導覽列品牌名稱（最多顯示 26 字元；HTML 會安全跳脫）
# BRANDING=ConvertX-CN

# 系統時區（預設 UTC）
TZ=Asia/Taipei

# 介面語言（預設 auto 自動偵測）
# 可選：zh-TW, zh-CN, en, ja, ko 等 65 種
# LANGUAGE=zh-TW

# Web UI 監聯端口
PORT=3000

# 子路徑前綴（用於反向代理配置）
# WEBROOT=/convertx

# 資料目錄
DATA_DIR=./data

# ========== 安全設定 ==========

# 是否允許 HTTP 連線（預設 false）
# 本地測試時設為 true
# HTTP_ALLOWED=true

# 是否信任反向代理（預設 false）
# 使用 Nginx/Traefik/Caddy 時設為 true
# TRUST_PROXY=true

# 是否允許註冊新帳號（預設 true）
# ACCOUNT_REGISTRATION=false

# 是否允許匿名使用（預設 false）
# ALLOW_UNAUTHENTICATED=true

# ========== MinerU 處理模式 ==========

# 處理模式（預設 pipeline）
# 可選：pipeline（穩定）, vlm（實驗性）
# 注意：本地 VLM / llama.cpp 功能已移除
# MINERU_MODE=pipeline

# ========== 轉換設定 ==========

# 自動刪除轉換檔案的間隔（小時，預設 24）
# AUTO_DELETE_EVERY_N_HOURS=12

# 最大同時轉換任務數（預設 0 表示無限制）
# MAX_CONVERT_PROCESS=4

# Maximum files accepted by one conversion job (default: 100)
# MAX_FILES_PER_JOB=100

# Maximum unfinished upload sessions retained per user (default: 100)
# MAX_UPLOAD_SESSIONS_PER_USER=100

# 是否隱藏轉換歷史（預設 false）
# HIDE_HISTORY=true

# 允許的檔案大小上限 (bytes，預設 500MB)
# HTTP_ALLOWED_FILE_SIZE=524288000

# Comma-separated Web user IDs allowed to run global memory GC/cleanup.
# Empty by default, which disables those destructive diagnostics for all users.
# MEMORY_DIAGNOSTICS_ADMIN_USER_IDS=1

# Optional custom PDF signing certificate. If omitted, a deployment-specific
# self-signed certificate is generated under DATA_DIR/certs.
# PDF_SIGN_P12_PATH=/run/secrets/signing.p12
# PDF_SIGN_P12_PASSWORD_FILE=/run/secrets/signing-password
# PDF_SIGN_P12_PASSWORD=

# ========== FFmpeg 設定（進階）==========

# FFmpeg 輸入參數
# FFMPEG_ARGS=-hwaccel cuda

# FFmpeg 輸出參數
# FFMPEG_OUTPUT_ARGS=-c:v h264_nvenc

# ========== PDF 翻譯設定 ==========

# PDFMathTranslate 翻譯服務（預設 google）
# PDFMATHTRANSLATE_SERVICE=google

# 模型路徑
# PDFMATHTRANSLATE_MODELS_PATH=/models

# ========== API Server 設定（選用）==========

# API Server 監聽端口
# RAS_API_PORT=7890

# ConvertX Web UI 後端地址（Docker 內部網路）
# CONVERTX_BACKEND_URL=http://convertx:3000
